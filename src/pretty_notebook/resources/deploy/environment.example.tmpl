# Copy to @ENV_FILE@ with mode 0600; set distinct private secrets before setup.
PNBP_DATA_DIR=@DATA_DIR@
PNBP_DATABASE_URL=sqlite://@DATA_DIR@/db.sqlite3
PNBP_ALLOWED_HOSTS=@DOMAIN@,127.0.0.1
PNBP_URL_PREFIX=@PREFIX@
PNBP_ASSET_MODE=local
JWT_ALGO=HS256
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET
PNBP_BOOTSTRAP_TOKEN=REPLACE_WITH_A_DIFFERENT_PRIVATE_RANDOM_SECRET
# Remove PNBP_BOOTSTRAP_TOKEN after claiming the initial owner, then restart.
